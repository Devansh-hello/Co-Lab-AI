# Next.js migration env template
# In local development, Next rewrites /api/* to the backend origin below.

# Backend origin for server-side rewrites/proxying (no trailing slash)
# NEXT_PUBLIC_API_ORIGIN=http://localhost:5000

# Optional direct API + WS client overrides
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Required for local dev (Next.js rewrites don't handle WebSocket upgrades)
NEXT_PUBLIC_WS_URL=ws://localhost:5000/ws

# Google OAuth client ID used by browser auth button
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
