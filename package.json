{
  "name": "co-lab-ai-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:runtime": "concurrently -k -n api,web \"npm run -w apps/api dev\" \"npm run -w apps/web runtime\"",
    "build": "turbo build",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "turbo": "^2.4.0"
  },
  "packageManager": "npm@9.2.0"
}
