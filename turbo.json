{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "inputs": ["src/**", "package.json", "tsconfig.json", "vite.config.ts", "next.config.ts", "next-env.d.ts"],
      "outputs": [".next/**", "dist/**", "build/**", "public/**"],
      "dependsOn": ["^build"]
    },
    "lint": {
      "inputs": ["src/**", "package.json", "eslint.config.js"],
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
